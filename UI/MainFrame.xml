<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <Frame name="GuildQuestsMainFrame" parent="UIParent" hidden="true" enableMouse="true" movable="true" frameStrata="HIGH">
        <Size x="840" y="620"/>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>
        <Layers>
            <Layer level="ARTWORK">
                <FontString name="$parentTitle" inherits="GameFontNormalLarge" justifyH="LEFT">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="16" y="-14"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <Button name="$parentClose" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-4" y="-4"/>
                </Anchors>
            </Button>
            <Button name="$parentCreate" inherits="UIPanelButtonTemplate" text="Create">
                <Size x="150" y="24"/>
                <Anchors>
                    <Anchor point="TOPRIGHT" x="-36" y="-10"/>
                </Anchors>
            </Button>
            <EditBox name="$parentSearch" inherits="InputBoxTemplate" autoFocus="false">
                <Size x="300" y="24"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="16" y="-42"/>
                </Anchors>
            </EditBox>
            <Frame name="$parentFilterBar" enableMouse="true">
                <Size x="800" y="28"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="16" y="-72"/>
                </Anchors>
            </Frame>
            <ScrollFrame name="$parentScroll" inherits="UIPanelScrollFrameTemplate">
                <Size x="800" y="460"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="12" y="-104"/>
                </Anchors>
                <ScrollChild>
                    <Frame name="$parentScrollChild">
                        <Size x="780" y="460"/>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>
</Ui>
